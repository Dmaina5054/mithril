{
  "uid": "mithril-kioo-bandwidth",
  "title": "Kioo Labs / Bandwidth per Subuser",
  "description": "IPRoyal residential bandwidth remaining and consumed per subuser, plus per-process attribution from the sock_ops eBPF program.",
  "tags": ["mithril", "kioo-labs", "iproyal", "shire-forge"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource",
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "IPRoyal Subuser Traffic Available (GB)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "iproyal_subuser_traffic_available_gb",
          "legendFormat": "{{subuser}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "IPRoyal Subuser Traffic Used (GB)",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "iproyal_subuser_traffic_used_gb",
          "legendFormat": "{{subuser}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decgbytes" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Per-Process Bytes Sent (eBPF sock_ops)",
      "description": "iproyal_process_bytes_sent_total from eBPF Feature 3 (per-process bandwidth accounting) — answers what % of subuser bandwidth a given process consumed.",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (process) (rate(iproyal_process_bytes_sent_total[5m]))",
          "legendFormat": "{{process}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      }
    }
  ]
}
