{
  "uid": "mithril-ebpf-per-process",
  "title": "eBPF / Per-Process Bandwidth",
  "description": "Dedicated per-process bandwidth breakdown from eBPF Feature 3 (sock_ops) — which process on Minas Tirith is consuming IPRoyal bandwidth, and how much, over the selected range.",
  "tags": ["mithril", "ebpf"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource",
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Bytes Sent by Process",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (process) (rate(iproyal_process_bytes_sent_total[5m]))",
          "legendFormat": "{{process}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Bytes Received by Process",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (process) (rate(iproyal_process_bytes_recv_total[5m]))",
          "legendFormat": "{{process}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Total Bytes Sent by Process (selected range)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (process) (increase(iproyal_process_bytes_sent_total[$__range]))",
          "legendFormat": "{{process}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      }
    }
  ]
}
