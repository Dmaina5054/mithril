# Copy to profiles.yaml (gitignored — real passwords go here, never
# commit) or to /etc/socks5-proxy/profiles.yaml on the deployed host.
#
# Each profile is backed by an internal/vpnprovider.Provider, selected
# by the `provider` field (default "iproyal" if omitted). See
# docs/diagrams/provider-plugin-architecture.md for how the plugin
# layer works, and main.go for which provider packages are compiled in
# ("iproyal", "socks5" as of this writing).
profiles:
  # Legacy shape — no `provider` field at all. Assumed to be "iproyal",
  # with username/password/subuser_hash/upstream_addr read straight off
  # the profile (exactly how every profiles.yaml worked before the
  # provider plugin layer existed). Password is the BASE IPRoyal
  # sub-user password — the iproyal provider appends the per-request
  # geo/session suffix on top of it at connection time; the base
  # password alone is never sent upstream as-is.
  default:
    username: "<default-subuser-username>"
    password: "<default-subuser-password>"
    listen_port: 1080
    bandwidth_alert_gb: 1
    # upstream_addr: "entry.iproyal.example:12345"  # optional per-profile
    #   override — falls back to $MITHRIL_UPSTREAM_ADDR if unset.

  # Same provider ("iproyal"), but written the modern way: `provider`
  # named explicitly and credentials under provider_config instead of
  # top-level fields. Equivalent to the legacy shape above — this is
  # what a NEW iproyal profile should look like; the legacy shape only
  # still works for backward compatibility.
  kioo-labs:
    provider: iproyal
    listen_port: 1081
    bandwidth_alert_gb: 0.5
    provider_config:
      subuser_hash: "<from IPRoyal dashboard, sub-user #89998755>"
      username: "kioolabs" # exact IPRoyal string — no hyphen, see AI-03
      password: "<kioolabs sub-user password>"
      # upstream_addr: "entry.iproyal.example:12345"  # optional, see above

  # A DIFFERENT provider — internal/vpnprovider/genericsocks5 — proving
  # the plugin layer isn't IPRoyal-specific. This one just dials a plain
  # SOCKS5 upstream (Tor's local port, in this example) with no
  # geo/session targeting at all; routing.yaml rules still match for
  # this profile, but their country/session fields are silently ignored
  # by this provider. See internal/vpnprovider/genericsocks5's package
  # doc comment before using this as a template for a real third-party
  # VPN — most real providers need their own package (own credential
  # encoding, own entry-node API), not just a provider_config change.
  tor:
    provider: socks5
    listen_port: 1082
    provider_config:
      upstream_addr: "127.0.0.1:9050" # Tor's default SOCKS5 port
      # username/password omitted — Tor's SOCKS5 port takes no auth
